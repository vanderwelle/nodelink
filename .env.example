# Copy to .env (gitignored). `npm run deploy:testnet` creates/fills this automatically.
NODELINK_NETWORK=testnet
# Generated on first deploy — never commit or share.
DEPLOYER_MNEMONIC=
NODELINK_APP_ID=
# Optional: separate key for the root-updater role (defaults to the deployer)
ROOT_UPDATER_MNEMONIC=
# Optional: AlgoKit TestNet dispenser token (`algokit dispenser login --ci`)
ALGOKIT_DISPENSER_ACCESS_TOKEN=
