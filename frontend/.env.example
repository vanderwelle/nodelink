# Copy to .env.local (written automatically by `npm run deploy:testnet`)
NEXT_PUBLIC_APP_ID=
NEXT_PUBLIC_NETWORK=testnet
# Read-only node telemetry network (Health/Rewards/Setup): mainnet | testnet | localnet.
# Defaults to NEXT_PUBLIC_NETWORK. Transactions always use NEXT_PUBLIC_NETWORK (never MainNet).
NEXT_PUBLIC_TELEMETRY_NETWORK=mainnet
